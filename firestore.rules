rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Admin authorization check:
    // 1. User document has role == 'Admin' or 'admin'
    // 2. OR Auth token has admin email / custom claim
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email in ['9118431155@rummyadda.app', '9118431155@phone.rummyadda.in', 'supportalkabrain@gmail.com', 'vermashreyansh580@gmail.com', 'admin@rummyadda.com'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'admin'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone == '9118431155'))
      );
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity verification probe
    match /test/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // User profile documents
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId);
      allow list: if isSignedIn();
      allow create: if (isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid
                    && (!('role' in request.resource.data) || request.resource.data.role == 'player'))
                    || isAdmin();
      allow update: if (isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == resource.data.uid
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role))
                    || isAdmin();
      allow delete: if isAdmin();
    }

    // Wallets: User can read only their own wallet; Admins can read & update
    match /wallets/{userId} {
      allow get: if (isOwner(userId) || isAdmin()) && isValidId(userId);
      allow list: if isAdmin();
      allow create: if (isOwner(userId) && isValidId(userId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.depositBalance == 0
                    && request.resource.data.winBalance == 0
                    && request.resource.data.bonusBalance == 0)
                    || isAdmin();
      allow update: if isAdmin(); // Admin can update balances upon deposit/withdrawal approval
      allow delete: if false;
    }

    // Transactions ledger: Admin can append transactions; users can read their own
    match /transactions/{transactionId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Deposits requests: Clients can submit 'pending'; Admin can view all and approve/reject
    match /deposits/{depositId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if (isSignedIn() && isValidId(depositId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending')
                    || isAdmin();
      allow update: if isAdmin(); // Trusted Admin can approve or reject
      allow delete: if isAdmin();
    }

    // Withdrawals requests: Clients can submit 'pending'; Admin can view all and process
    match /withdrawals/{withdrawalId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow list: if isSignedIn();
      allow create: if (isSignedIn() && isValidId(withdrawalId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'pending')
                    || isAdmin();
      allow update: if isAdmin(); // Trusted Admin can approve or reject
      allow delete: if isAdmin();
    }

    // Matchmaking queue tickets: Owned strictly by the queuing player
    match /matchmakingQueue/{ticketId} {
      allow read: if isSignedIn() && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && isValidId(ticketId)
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.status == 'QUEUED';
      allow update: if isSignedIn() && isValidId(ticketId)
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Public game tables list & lobby occupancy
    match /gameTables/{tableId} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidId(tableId);
      allow delete: if isAdmin();
    }

    // Live games metadata
    match /games/{gameId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(gameId);
      allow update: if isSignedIn() && isValidId(gameId)
                    && (!('winnerUid' in resource.data) || resource.data.winnerUid == null || request.resource.data.winnerUid == resource.data.winnerUid);
      allow delete: if isAdmin();

      match /players/{playerId} {
        allow read: if isSignedIn() && isValidId(playerId);
        allow create: if isSignedIn() && isValidId(playerId) && request.auth.uid == playerId;
        allow update: if isSignedIn() && isValidId(playerId)
                      && request.auth.uid == playerId
                      && request.resource.data.uid == resource.data.uid;
        allow delete: if isSignedIn() && (request.auth.uid == playerId || resource.data.uid == request.auth.uid || isAdmin());
      }

      match /internal/{internalDoc} {
        allow read, write: if false;
      }
    }

    // Tournaments
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /tournamentRegistrations/{regId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Notification preferences
    match /notificationPreferences/{userId} {
      allow read, write: if (isOwner(userId) || isAdmin()) && isValidId(userId);
    }

    // App configuration
    match /appConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Support requests
    match /supportRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if request.resource.data.uid == (request.auth != null ? request.auth.uid : 'guest');
      allow update, delete: if isAdmin();
    }
  }
}
